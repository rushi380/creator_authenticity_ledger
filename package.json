{
  "name": "creator-authenticity-ledger",
  "version": "1.0.0",
  "description": "Privacy-preserving creator authenticity verification on Midnight Network",
  "private": true,
  "repository": "https://github.com/rushi380/creator_authenticity_ledger.git",
  "homepage": "https://github.com/rushi380/creator_authenticity_ledger",
  "type": "module",
  "scripts": {
    "setup": "npm install && npm run build:contract",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "compile:contract": "compact compile contracts/creator_authenticity.compact ./managed",
    "copy:artifacts": "node scripts/copy-artifacts.cjs",
    "build:contract": "npm run compile:contract && npm run copy:artifacts",
    "deploy:dryrun": "node scripts/deploy-dryrun.mjs",
    "deploy:preview": "node scripts/deploy-preprod.mjs",
    "deploy:preprod": "node scripts/deploy-preprod.mjs",
    "clean": "rimraf dist managed public/keys public/zkir"
  },
  "dependencies": {
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "^4.1.1",
    "@midnight-ntwrk/wallet-sdk": "^1.2.0",
    "bip39": "^3.1.0",
    "framer-motion": "^11.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.22.0",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "@midnight-ntwrk/compact-runtime": "0.15.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1"
  },
  "devDependencies": {
    "@midnight-ntwrk/dapp-connector-api": "^4.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.0",
    "rimraf": "^5.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^1.6.0"
  }
}
