# Midnight Network Configuration
# Copy this file to .env and fill in your values.
# Never commit .env with real secrets.

# Network to connect to: "preview" | "preprod" | "undeployed"
VITE_NETWORK=preview

# Deployed contract address (set after running deploy script)
VITE_CONTRACT_ADDRESS=

# Public app URL (set after frontend deployment)
VITE_APP_URL=

# Proof server URL (local Docker or remote)
VITE_PROOF_SERVER_URL=http://localhost:6300

# Midnight indexer endpoint
VITE_INDEXER_URL=https://indexer.preview.midnight.network/api/v4/graphql

# Midnight node endpoint
VITE_NODE_URL=https://rpc.preview.midnight.network

# Minimum engagement rate in basis points (300 = 3.00%)
VITE_MIN_ENGAGEMENT_BPS=300

# Minimum posting consistency score (0-100)
VITE_MIN_CONSISTENCY=60

# Minimum verified audience score (0-100)
VITE_MIN_AUDIENCE_SCORE=70
